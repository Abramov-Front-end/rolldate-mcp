{
  "name": "@rolldate/mcp",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.0.0",
  "description": "MCP server for RollDate — install assets, snippets, API reference for AI agents (Cursor & other IDEs)",
  "type": "module",
  "bin": {
    "rolldate-mcp": "bin/rolldate-mcp.js"
  },
  "main": "./src/index.js",
  "files": [
