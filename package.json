  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "homepage": "https://rolldate-demo.vercel.app/#mcp",
  "bugs": {
    "email": "rolldate.support@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abramov-Front-end/rolldate-mcp.git"
